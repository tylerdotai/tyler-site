---
interface Props {
  images: Array<{ src: string; alt: string; caption?: string }>;
}

const { images } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {images.map((img) => (
    <figure class="neo-panel">
      <img
        src={img.src}
        alt={img.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-64 object-cover border-[3px] border-black"
      />
      {img.caption && (
        <figcaption class="mt-3 font-body text-sm font-bold uppercase tracking-wider text-black">{img.caption}</figcaption>
      )}
    </figure>
  ))}
</div>
