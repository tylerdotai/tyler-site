---
interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'en' } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class="text-sm text-[#8EA3B8]">Language:</span>
  <a
    href="/parkinson"
    class={`text-sm font-medium ${currentLang === 'en' ? 'text-[#00F5FF]' : 'text-[#8EA3B8] hover:text-[#00F5FF]'}`}
  >
    English
  </a>
  <span class="text-[#8EA3B8]">/</span>
  <a
    href="/parkinson/es"
    class={`text-sm font-medium ${currentLang === 'es' ? 'text-[#00F5FF]' : 'text-[#8EA3B8] hover:text-[#00F5FF]'}`}
  >
    Español
  </a>
</div>
