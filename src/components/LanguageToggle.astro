---
interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'en' } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class="text-sm text-[#888888]">Language:</span>
  <a
    href="/parkinson"
    class={`text-sm font-medium ${currentLang === 'en' ? 'text-[#C9A84C]' : 'text-[#888888] hover:text-[#C9A84C]'}`}
  >
    English
  </a>
  <span class="text-[#888888]">/</span>
  <a
    href="/parkinson/es"
    class={`text-sm font-medium ${currentLang === 'es' ? 'text-[#C9A84C]' : 'text-[#888888] hover:text-[#C9A84C]'}`}
  >
    Español
  </a>
</div>
