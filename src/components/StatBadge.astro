---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="neo-panel">
  <span class="font-display text-5xl text-black">{value}</span>
  <span class="mt-2 block font-body text-sm font-bold uppercase tracking-wider text-black opacity-70">{label}</span>
</div>
