---
interface Props {
  href: string;
  label: string;
  description?: string;
}

const { href, label, description } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="neo-panel group flex items-start gap-4"
>
  <div class="flex-1">
    <span class="block font-display text-xl text-black group-hover:text-blue transition-colors">{label}</span>
    {description && <span class="mt-1 block font-body text-sm text-black opacity-70">{description}</span>}
  </div>
  <div class="flex h-10 w-10 shrink-0 items-center justify-center bg-yellow border-[3px] border-black shadow-[3px_3px_0_#000000]">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
      <polyline points="15 3 21 3 21 9"/>
      <line x1="10" y1="14" x2="21" y2="3"/>
    </svg>
  </div>
</a>
