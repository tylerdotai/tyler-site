---
interface Props {
  href: string;
  label: string;
  description?: string;
}

const { href, label, description } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-3 px-4 py-3 border border-[#E8E4DC] rounded hover:border-[#FF6B00] transition-colors duration-150 group"
>
  <div>
    <span class="text-sm font-medium text-[#1A1A1A] group-hover:text-[#FF6B00] transition-colors duration-150">{label}</span>
    {description && <span class="block text-xs text-[#6B6B6B]">{description}</span>}
  </div>
  <svg class="ml-auto text-[#6B6B6B]" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
    <polyline points="15 3 21 3 21 9"/>
    <line x1="10" y1="14" x2="21" y2="3"/>
  </svg>
</a>
