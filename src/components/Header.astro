---
import { MobileNav } from '../components/ui/MobileNav';
import { NAV_LINKS, SITE } from '../config';

const pathname = Astro.url.pathname;
const _socialLinks = [
  { href: SITE.x, label: 'X / TWITTER' },
];
---

<header id="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- Logo -->
      <a href="/" class="logo" aria-label="Tyler Delano home">
        @TYLERDOTAI
      </a>

      <!-- Desktop nav -->
      <nav class="nav-desktop" aria-label="Main navigation">
        {NAV_LINKS.map(link => (
          <a
            href={link.href}
            class={`nav-link ${pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'active' : ''}`}
          >
            {link.label}
          </a>
        ))}
        <a href={SITE.x} target="_blank" rel="noopener noreferrer" class="nav-link">
          X / TWITTER
        </a>
      </nav>

      <!-- Mobile nav (React) -->
      <div class="nav-mobile">
        <MobileNav client:load currentPath={pathname} />
      </div>
    </div>
  </div>
</header>

<style>
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #000000;
    border-bottom: 3px solid #000000;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Logo */
  .logo {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .logo:hover {
    opacity: 0.8;
  }

  /* Desktop nav */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }

  .nav-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #FFFFFF;
    text-decoration: none;
    position: relative;
    transition: color 120ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #00B8FF;
    transition: width 120ms ease;
  }

  .nav-link:hover {
    color: #FFFFFF;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link.active {
    color: #00B8FF;
  }

  .nav-link.active::after {
    width: 100%;
    background: #00B8FF;
  }

  /* Mobile nav */
  .nav-mobile {
    display: block;
  }

  @media (min-width: 768px) {
    .nav-mobile {
      display: none;
    }
  }
</style>
