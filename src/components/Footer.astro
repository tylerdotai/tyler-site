---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-inner">
      <p class="footer-copy">
        &copy; {year} @tylerdotai
      </p>
      <nav class="footer-socials" aria-label="Social links">
        <a href="https://x.com/tylerdotai" target="_blank" rel="noopener noreferrer">X</a>
        <a href="https://linkedin.com/in/tylerpdelano" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/tylerdotai" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #000000;
    border-top: 4px solid #000000;
    padding: 2rem 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-copy {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: #D2D2D2;
    letter-spacing: 0.05em;
  }

  .footer-socials {
    display: flex;
    gap: 1.5rem;
  }

  .footer-socials a {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: #FFFFFF;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 120ms ease;
  }

  .footer-socials a:hover {
    color: #007AFF;
  }
</style>
