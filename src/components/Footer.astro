---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/tylerdotai', label: 'GitHub' },
  { href: 'https://linkedin.com/in/tylerpdelano', label: 'LinkedIn' },
  { href: 'https://x.com/tylerdotai', label: 'X' },
  { href: 'https://discord.gg/tylerdotai', label: 'Discord' },
];
---

<footer class="mt-auto border-t-[3px] border-black bg-white">
  <div class="container py-8">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
      <div class="neo-panel">
        <p class="font-body text-sm font-bold uppercase tracking-widest">
          &copy; {year} @tylerdotai // signal vault
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-xs"
            aria-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
