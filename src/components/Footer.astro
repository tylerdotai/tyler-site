---
const year = new Date().getFullYear();
const links = [
  { href: 'https://github.com/tylerdotai', label: 'GitHub' },
  { href: 'https://linkedin.com/in/tylerpdelano', label: 'LinkedIn' },
  { href: 'https://x.com/tylerdotai', label: 'X' },
  { href: 'https://discord.gg/tylerdotai', label: 'Discord' },
];
---

<footer class="mt-auto border-t-[3px] border-black bg-white">
  <div class="container py-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Copyright -->
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-black">
          &copy; {year} <span class="text-blue font-bold">@tylerdotai</span> // signal vault
        </p>
        <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-black/50 mt-1">
          tylerdotai.com
        </p>
      </div>

      <!-- Social links -->
      <nav class="flex flex-wrap items-center gap-2" aria-label="Social links">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[11px] uppercase tracking-[0.15em] text-black border-b-2 border-blue hover:text-blue transition-colors pb-0.5"
            aria-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
