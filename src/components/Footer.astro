---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[#E8E4DC]">
  <div class="container py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-sm text-[#6B6B6B]">
        &copy; {year} Tyler Delano. All rights reserved.
      </p>

      <div class="flex items-center gap-6">
        <a
          href="https://github.com/tylerdotai"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#6B6B6B] hover:text-[#FF6B00] transition-colors"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/tylerpdelano"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#6B6B6B] hover:text-[#FF6B00] transition-colors"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
        <a
          href="https://x.com/tylerdotai"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#6B6B6B] hover:text-[#FF6B00] transition-colors"
          aria-label="X / Twitter"
        >
          X
        </a>
        <a
          href="https://discord.gg/tylerdotai"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#6B6B6B] hover:text-[#FF6B00] transition-colors"
          aria-label="Discord"
        >
          Discord
        </a>
      </div>
    </div>
  </div>
</footer>
