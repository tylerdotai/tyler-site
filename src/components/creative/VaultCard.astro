---
interface Props {
  label: string;
  title: string;
  image: string;
  alt: string;
  meta: string;
  index: number;
  size?: string;
}

const { label, title, image, alt, meta, index, size = 'square' } = Astro.props;
const normalizedSize = ['wide', 'tall', 'square'].includes(size) ? size : 'square';
const sizeClass = {
  wide: 'md:col-span-2',
  tall: 'md:row-span-2',
  square: '',
}[normalizedSize];
const imgClass = normalizedSize === 'tall' ? 'h-[560px]' : normalizedSize === 'wide' ? 'h-[360px]' : 'h-[300px]';
---

<button
  type="button"
  class={`vault-card brutal-card group relative block w-full overflow-hidden text-left cursor-pointer ${sizeClass}`}
  data-lightbox-src={image}
  data-lightbox-title={title}
  data-lightbox-meta={`${label} // ${meta}`}
  aria-label={`Open ${title}`}
>
  <div class="absolute left-3 top-3 z-10 font-mono text-[10px] tracking-[0.2em] text-black bg-yellow px-2 py-1 border-2 border-black">
    IMG_{String(index).padStart(2, '0')}
  </div>
  <img
    src={image}
    alt={alt}
    loading="eager"
    decoding="async"
    class={`${imgClass} w-full object-cover grayscale-[20%] group-hover:grayscale-0 transition duration-200`}
  />
  <div class="absolute inset-x-0 bottom-0 p-4 bg-white border-t-3 border-black">
    <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-black bg-yellow px-2 py-0.5 inline-block border border-black mb-2">{label}</p>
    <h3 class="text-xl leading-tight text-black font-display uppercase">{title}</h3>
    <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-black">{meta}</p>
  </div>
</button>

<style>
  .brutal-card {
    background: white;
    border: 3px solid black;
    box-shadow: 6px 6px 0 black;
    transition: transform 100ms ease, box-shadow 100ms ease;
  }

  .brutal-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 black;
  }

  .brutal-card:active {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 black;
  }
</style>
