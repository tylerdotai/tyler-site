---
interface Props {
  label: string;
  title: string;
  image: string;
  alt: string;
  meta: string;
  index: number;
  size?: string;
}

const { label, title, image, alt, meta, index, size = 'square' } = Astro.props;
const normalizedSize = ['wide', 'tall', 'square'].includes(size) ? size : 'square';
const sizeClass = {
  wide: 'md:col-span-2',
  tall: 'md:row-span-2',
  square: '',
}[normalizedSize];
const imgClass = normalizedSize === 'tall' ? 'h-[480px]' : normalizedSize === 'wide' ? 'h-[320px]' : 'h-[280px]';
---

<button
  type="button"
  class={`vault-card brutal-card group relative block w-full overflow-hidden text-left cursor-pointer ${sizeClass}`}
  data-lightbox-src={image}
  data-lightbox-title={title}
  data-lightbox-meta={`${label} // ${meta}`}
  aria-label={`Open ${title}`}
>
  <!-- Index label -->
  <div class="absolute left-3 top-3 z-10 font-mono text-[10px] tracking-[0.2em] text-black bg-yellow px-2 py-1 border-2 border-black">
    IMG_{String(index).padStart(2, '0')}
  </div>

  <!-- Image — full color, no filter -->
  <img
    src={image}
    alt={alt}
    loading="eager"
    decoding="async"
    class={`${imgClass} w-full object-cover transition duration-200`}
  />

  <!-- Caption bar -->
  <div class="absolute inset-x-0 bottom-0 p-4 bg-white border-t-3 border-black">
    <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-black bg-yellow px-2 py-0.5 inline-block border border-black mb-2">{label}</p>
    <h3 class="text-lg leading-tight text-black font-display uppercase">{title}</h3>
    <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-black/60">{meta}</p>
  </div>
</button>
