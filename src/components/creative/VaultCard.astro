---
interface Props {
  label: string;
  title: string;
  image: string;
  alt: string;
  meta: string;
  index: number;
  size?: string;
}

const { label, title, image, alt, meta, index, size = 'square' } = Astro.props;
const normalizedSize = ['wide', 'tall', 'square'].includes(size) ? size : 'square';
const sizeClass = {
  wide: 'md:col-span-2',
  tall: 'md:row-span-2',
  square: '',
}[normalizedSize];
const imgClass = normalizedSize === 'tall' ? 'h-[560px]' : normalizedSize === 'wide' ? 'h-[360px]' : 'h-[300px]';
---

<button
  type="button"
  class={`vault-card y2k-panel group relative block w-full overflow-hidden text-left ${sizeClass}`}
  data-lightbox-src={image}
  data-lightbox-title={title}
  data-lightbox-meta={`${label} // ${meta}`}
  aria-label={`Open ${title}`}
>
  <div class="absolute left-3 top-3 z-10 font-mono text-[10px] tracking-[0.2em] text-[#39FF14]">
    IMG_{String(index).padStart(2, '0')}
  </div>
  <img
    src={image}
    alt={alt}
    loading="eager"
    decoding="async"
    class={`${imgClass} w-full object-cover transition duration-300 group-hover:scale-[1.025] group-hover:saturate-[1.2]`}
  />
  <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_45%,rgba(5,7,10,0.92)_100%)]"></div>
  <div class="absolute inset-0 opacity-0 mix-blend-screen transition-opacity duration-200 group-hover:opacity-60" style="background: linear-gradient(90deg, transparent, rgba(0,245,255,0.18), rgba(255,43,214,0.14), transparent);"></div>
  <div class="absolute inset-x-0 bottom-0 p-4">
    <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[#00F5FF]">{label}</p>
    <h3 class="mt-1 text-xl leading-tight text-[#F2F7FF]">{title}</h3>
    <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-[#8EA3B8]">{meta}</p>
    <p class="mt-3 inline-flex border border-[#00F5FF] px-2 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-[#00F5FF]">View fullframe</p>
  </div>
</button>
