---
interface Props {
  dayNumber: number;
  title: string;
  quote: string;
  quoteSource?: string;
  imageSrc: string;
  alt: string;
}

const { dayNumber, title, quote, quoteSource, imageSrc, alt } = Astro.props;
---

<article class="grid md:grid-cols-2 gap-8 items-center py-8 border-b border-[#2A2A2A] last:border-b-0">
  <div class="relative">
    <img
      src={imageSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="w-full h-80 object-cover rounded"
    />
    <span class="absolute top-4 left-4 px-3 py-1 bg-[#C9A84C] text-[#0E0E0E] text-xs font-mono rounded">
      Day {dayNumber}
    </span>
  </div>

  <div>
    <h3 class="font-serif text-2xl mb-3">{title}</h3>
    <blockquote class="border-l-2 border-[#C9A84C] pl-4 mb-2">
      <p class="text-[#888888] italic">"{quote}"</p>
    </blockquote>
    {quoteSource && <p class="text-xs text-[#888888]">— {quoteSource}</p>}
  </div>
</article>
