---
interface Props {
  dayNumber: number;
  title: string;
  quote: string;
  quoteSource?: string;
  imageSrc: string;
  alt: string;
}

const { dayNumber, title, quote, quoteSource, imageSrc, alt } = Astro.props;
---

<article class="grid gap-8 py-8 border-b-[3px] border-black last:border-b-0 md:grid-cols-2 md:items-center">
  <div class="relative">
    <img
      src={imageSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="w-full h-80 object-cover border-[3px] border-black shadow-[6px_6px_0_#000000]"
    />
    <span class="absolute top-4 left-4 bg-yellow px-3 py-1 font-body text-sm font-bold uppercase tracking-wider border-[3px] border-black shadow-[3px_3px_0_#000000]">
      Day {dayNumber}
    </span>
  </div>

  <div class="neo-panel">
    <h3 class="font-display text-3xl text-black mb-4">{title}</h3>
    <blockquote class="border-l-[6px] border-blue pl-4 mb-3">
      <p class="font-body text-black italic">"{quote}"</p>
    </blockquote>
    {quoteSource && <p class="font-body text-sm font-bold uppercase tracking-wider text-black opacity-60">— {quoteSource}</p>}
  </div>
</article>
