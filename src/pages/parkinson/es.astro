---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';

const lang = 'es';
---

<BaseLayout
  title="Parkinson"
  description="Informes diarios de investigación sobre el Parkinson, en inglés y español."
>
  <Header />

  <main>
    <!-- Hero -->
    <section style="background:#000000; border-bottom: 4px solid #000000;">
      <div class="container" style="padding-top:4rem; padding-bottom:4rem;">
        <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
          <span style="font-family:'Space Mono',monospace; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.2em; color:#00B8FF;">AIAgainstParkinson</span>
          <LanguageToggle currentLang={lang} />
        </div>

        <h1 style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.9; color:#FFFFFF; font-size:var(--text-h1); margin-bottom:1rem;">
          Cada día.<br />Cada estudio.
        </h1>
        <p style="font-size:1.125rem; color:#D2D2D2; max-width:42rem; line-height:1.7;">
          AIAgainstParkinson encuentra y resume lo último en investigación sobre
          Parkinson cada día — automáticamente. Hecho para pacientes, cuidadores e
          investigadores que no tienen tiempo de leer todo.
        </p>
      </div>
    </section>

    <!-- Mission -->
    <section style="background:#D2D2D2; border-bottom: 4px solid #000000;">
      <div class="container" style="padding-top:4rem; padding-bottom:4rem;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:3rem;">

          <div>
            <h2 style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95; color:#000000; font-size:var(--text-h2); margin-bottom:1rem;">
              Esto es personal.
            </h2>
            <p style="color:#000000; margin-bottom:1rem; line-height:1.7;">
              Alguien que me importa vive con Parkinson. Cada mañana, un cron job lee los
              últimos artículos de PubMed, genera un resumen en lenguaje simple en inglés
              y español, y lo publica — automáticamente.
            </p>
            <p style="color:#000000;">
              Sin paywall. Sin algoritmo. Solo investigación, entregada.
            </p>
          </div>

          <div>
            <h2 style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95; color:#000000; font-size:var(--text-h2); margin-bottom:1rem;">
              Informes cada día.
            </h2>
            <p style="color:#000000; margin-bottom:1.5rem; line-height:1.7;">
              Disponible en inglés y español actualmente. Cero suscriptores — el sistema
              corre sin importar nada. Sígueme en X.
            </p>
            <a
              href="https://github.com/tylerdotai/parkinson-research"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              Ver en GitHub
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:#D2D2D2;">
      <div class="container" style="padding-top:4rem; padding-bottom:4rem; text-align:center;">
        <p style="color:#000000; margin-bottom:1rem; line-height:1.7;">
          AIAgainstParkinson es un pipeline de investigación automatizado.
        </p>
        <a
          href="https://x.com/tylerdotai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Seguir en X
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
