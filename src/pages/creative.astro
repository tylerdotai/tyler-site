---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Creative"
  description="Sony ZV-E10 challenge. No crew. No script. 39 days of documentary-style filmmaking."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <p class="section-label mb-4">Filmmaking</p>
        <h1 class="text-5xl font-serif mb-4">Sony ZV-E10 Challenge</h1>
        <p class="text-xl text-[#888888] max-w-2xl mb-6">
          39 days. One camera. No crew. No script. Every clip is a real moment.
          This is documentary-style filmmaking as a brand amplifier — not a business.
        </p>
        <a href="https://x.com/tylerdotai" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          Follow on X for new clips
        </a>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="max-w-2xl">
          <h2 class="font-serif text-3xl mb-6">No crew. No script.</h2>
          <p class="text-[#888888] mb-4 leading-relaxed">
            Most "content" is produced. There's a team, a script, a brand strategy,
            and a content calendar. This is different.
          </p>
          <p class="text-[#888888] mb-4 leading-relaxed">
            The ZV-E10 challenge is a daily filming habit. I carry the camera everywhere.
            Whatever happens, happens. The documentary-style framing — the real moments,
            the homestead, the road — that's the point. Not the footage itself.
          </p>
          <p class="text-[#888888]">
            The footage accumulates. The habit compounds. The authenticity is the brand.
          </p>
        </div>
      </div>
    </section>

    <!-- Photo Gallery — editorial two-column layout -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <p class="section-label mb-8">From the archive</p>
        <div class="grid md:grid-cols-2 gap-6">
          <figure>
            <img
              src="/assets/creative/day1-homestead-dog.jpg"
              alt="Dog on the homestead"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 1 — Homestead</figcaption>
          </figure>
          <figure>
            <img
              src="/assets/creative/day1-homestead-cat.jpg"
              alt="Cat on the homestead"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 1 — Cat</figcaption>
          </figure>
          <figure>
            <img
              src="/assets/creative/day1-chickens-farm.jpg"
              alt="Chickens on the farm"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 1 — Chickens</figcaption>
          </figure>
          <figure>
            <img
              src="/assets/creative/day2-gas-station.jpg"
              alt="Gas station"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 2 — Gas station</figcaption>
          </figure>
          <figure>
            <img
              src="/assets/creative/day2-sony.jpg"
              alt="Sony ZV-E10"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 2 — Camera</figcaption>
          </figure>
          <figure>
            <img
              src="/assets/creative/day3-kitchen.jpg"
              alt="Kitchen natural light"
              loading="lazy"
              decoding="async"
              class="w-full h-72 object-cover rounded"
            />
            <figcaption class="mt-2 text-sm text-[#888888]">Day 3 — Kitchen</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Video Clips -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <p class="section-label mb-8">Video</p>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h2 class="font-serif text-xl mb-3">Homestead — Kitchen</h2>
            <video
              controls
              preload="metadata"
              class="w-full rounded"
              poster="/assets/creative/video-preview.jpg"
            >
              <source src="/assets/creative/dayx-homestead-video.mov" type="video/quicktime" />
              Your browser does not support the video tag.
            </video>
            <p class="mt-2 text-sm text-[#888888]">Day X — Natural light, ice dispenser moment.</p>
          </div>

          <div>
            <h2 class="font-serif text-xl mb-3">Homestead — Doorway</h2>
            <video
              controls
              preload="metadata"
              class="w-full rounded"
              poster="/assets/creative/video2-preview.jpg"
            >
              <source src="/assets/creative/dayx-homestead-video2.mov" type="video/quicktime" />
              Your browser does not support the video tag.
            </video>
            <p class="mt-2 text-sm text-[#888888]">Day X — Ford F-150, bright daylight narrative.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container text-center">
        <p class="text-[#888888] mb-4">New clips post as they're filmed.</p>
        <a href="https://x.com/tylerdotai" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Follow on X
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
