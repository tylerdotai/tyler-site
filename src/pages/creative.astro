---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VaultCard from '../components/creative/VaultCard.astro';

const vaultItems = [
  {
    label: 'Portrait / extreme close-up',
    title: 'Direct signal.',
    image: '/assets/creative/tyler-extreme-closeup.jpg',
    alt: 'Extreme close-up portrait of Tyler Delano looking directly into the camera',
    meta: 'Face study / shallow depth',
    size: 'wide',
  },
  {
    label: 'Homestead / cat',
    title: 'Cat close-up in grass.',
    image: '/assets/creative/day1-cat-closeup.jpg',
    alt: 'Close-up portrait of a cream-colored cat outdoors with green grass behind',
    meta: 'Photo / natural light',
    size: 'square',
  },
  {
    label: 'Homestead / cat',
    title: 'Low-light carpet frame.',
    image: '/assets/creative/day1-cat-carpet.jpg',
    alt: 'Cream-colored cat lying on carpet in dim indoor light',
    meta: 'Photo / indoor low light',
    size: 'square',
  },
  {
    label: 'Homestead / dog',
    title: 'Golden retriever outside.',
    image: '/assets/creative/day1-homestead-dog.jpg',
    alt: 'Golden Retriever sitting outside on the homestead',
    meta: 'Photo / outdoor portrait',
    size: 'wide',
  },
  {
    label: 'Homestead / chickens',
    title: 'Chicken pen close-up.',
    image: '/assets/creative/day1-chickens-alt.jpg',
    alt: 'Backyard chickens behind a chain-link fence',
    meta: 'Photo / backyard pen',
    size: 'square',
  },
  {
    label: 'Roadside / Chevron',
    title: 'Canopy angle.',
    image: '/assets/creative/day2-chevron-lowangle.jpg',
    alt: 'Low-angle tilted photograph of a Chevron gas station canopy against a blue sky',
    meta: 'Photo / low angle',
    size: 'wide',
  },
  {
    label: 'Roadside / station',
    title: 'Cornerstore vibes.',
    image: '/assets/creative/day2-gas-station.jpg',
    alt: 'Gas station convenience store with Redbox kiosk in the foreground',
    meta: 'Photo / cornerstore frame',
    size: 'square',
  },
  {
    label: 'Desk / interface',
    title: 'Desktop timeline.',
    image: '/assets/creative/desk-setup.jpg',
    alt: 'Wide monitor and red keyboard on a desk setup',
    meta: 'Photo / edit bay',
    size: 'wide',
  },
  {
    label: 'Exterior / rose',
    title: 'Rose against siding.',
    image: '/assets/creative/dayx-rose.jpg',
    alt: 'Pink rose blooming against white exterior siding',
    meta: 'Photo / exterior detail',
    size: 'square',
  },
];

const reelItems = [
  {
    label: 'VIDEO // DAY THREE',
    title: 'Natural kitchen light + Dr Pepper.',
    src: '/assets/creative/day3-kitchen-light.mp4',
    poster: '/assets/creative/video-preview.jpg',
    stillLabel: 'VIDEO STILL / kitchen frame poster',
    duration: '00:29',
    href: 'https://x.com/tylerdotai/status/2069840988256841871',
    note: 'Wide, medium, close — one frame at a time. The kitchen frame is a video poster, not a standalone photo.',
  },
  {
    label: 'VIDEO // GOD BLESS THE USA',
    title: 'Shot on Sony Alpha ZV-E10. Edited in CapCut.',
    src: '/assets/creative/god-bless-usa.mp4',
    poster: '/assets/creative/video2-preview.jpg',
    stillLabel: 'VIDEO STILL / doorway poster',
    duration: '00:43',
    href: 'https://x.com/tylerdotai/status/2069950589060936108',
    note: 'Social cut with native playback here and source link preserved.',
  },
];

const socialLinks = [
  { href: 'https://x.com/tylerdotai', label: 'X / Twitter', primary: true },
  { href: 'https://github.com/tylerdotai', label: 'GitHub', primary: false },
  { href: 'https://www.linkedin.com/in/tylerpdelano', label: 'LinkedIn', primary: false },
];
---

<BaseLayout
  title="Creative"
  description="Tyler Delano visual archive — photography and video from the Sony ZV-E10 challenge, presented as a Neo-Brutalist media vault."
  ogImage="/assets/creative/tyler-extreme-closeup.jpg"
>
  <Header />

  <main>
    <!-- ── HERO: full-bleed video ── -->
    <section class="bg-black border-b-4 border-[#4D4D4D]">
      <div class="relative min-h-[90vh] overflow-hidden">
        <!-- Video: 60% opacity — visible but readable -->
        <video
          class="absolute inset-0 h-full w-full object-cover opacity-60"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="/assets/creative/day3-kitchen-light.mp4" type="video/mp4" />
        </video>
        <!-- Dark overlay for text readability -->
        <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.85)_0%,rgba(0,0,0,0.3)_60%,rgba(0,0,0,0.5)_100%)]"></div>
        <!-- Content -->
        <div class="relative container flex min-h-[90vh] items-end pb-16 pt-32">
          <div class="max-w-5xl">
            <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end reveal">
            <div>
              <span class="section-label mb-5 inline-block reveal">@TYLERDOTAI // SIGNAL VAULT</span>
              <div class="flex items-end gap-6 mb-6">
                <h1 class="font-display mb-0 reveal font-bebas text-[var(--text-h1)] font-normal uppercase leading-[0.9] text-white">
                  SIGNAL<br/>VAULT
                </h1>
                <span class="font-mono text-xs text-[#4D4D4D] uppercase tracking-widest mb-3 hidden md:block">02</span>
              </div>
              <p class="max-w-2xl text-lg leading-relaxed text-[#D2D2D2] reveal">
                Photography, video stills, and short-form motion work from Tyler Delano's Sony ZV-E10 archive — high contrast, real frames, no stock filler.
              </p>
            </div>
            <div class="bg-black border-3 border-[#4D4D4D] p-4 px-5 box-content shadow-[4px_4px_0_#00B8FF] min-w-[180px]">
              <p class="font-mono text-xs leading-relaxed text-[#D2D2D2] font-space-mono">
                <span class="text-[#00B8FF]">MODE</span> // NEO-BRUTALIST<br/>
                <span class="text-[#00B8FF]">DEVICE</span> // SONY ZV-E10
              </p>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── PHOTO VAULT ── -->
    <section class="bg-black border-b-4 border-[#4D4D4D]">
      <div class="container py-24 md:py-32">
        <!-- Section heading -->
        <div class="grid gap-6 mb-12 lg:grid-cols-[0.7fr_1.3fr] lg:items-end reveal">
          <div>
            <span class="section-label mb-4 inline-block">The Vault</span>
            <h2 class="font-display font-bebas text-[var(--text-h2)] font-normal uppercase leading-[0.9] text-white">
              PHOTO<br/>DATASET
            </h2>
          </div>
          <p class="max-w-3xl leading-relaxed text-[#D2D2D2]">
            Every unique standalone photo in the archive shown once. No duplicates rendered publicly. Video posters live in The Reel — separate from the still dataset.
          </p>
        </div>

        <!-- Grid — auto-size rows so images never collapse -->
        <div class="grid gap-6 md:grid-cols-3 md:auto-rows-[280px]">
          {vaultItems.map((item, index) => (
            <VaultCard {...item} index={index + 1} class="reveal" />
          ))}
        </div>
      </div>
    </section>

    <!-- ── REEL ── -->
    <section class="bg-black border-b-4 border-[#4D4D4D]">
      <div class="container py-24 md:py-32">
        <div class="mb-10 reveal">
          <span class="section-label mb-4 inline-block">The Reel</span>
          <h2 class="font-display font-bebas text-[var(--text-h2)] font-normal uppercase leading-[0.9] text-white">
            VIDEO<br/>ARCHIVE
          </h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {reelItems.map((item) => (
            <div class="reveal border-3 border-black shadow-[4px_4px_0_#00B8FF] overflow-hidden">
              <!-- Label -->
              <div class="bg-black border-b-3 border-black px-4 py-3">
                <span class="font-mono text-xs uppercase tracking-widest font-bold text-[#00B8FF] font-space-mono">{item.label}</span>
              </div>
              <!-- Video -->
              <div class="relative bg-black">
                <video
                  class="w-full aspect-video object-cover"
                  poster={item.poster}
                  controls
                  preload="metadata"
                >
                  <source src={item.src} type="video/mp4" />
                </video>
                <div class="bg-black border-t-3 border-black px-4 py-2 flex items-center justify-between">
                  <span class="font-mono text-xs text-[#00B8FF] font-space-mono">{item.duration}</span>
                  <span class="font-mono text-xs text-[#00B8FF] font-space-mono">{item.stillLabel}</span>
                </div>
              </div>
              <!-- Info -->
              <div class="bg-[#D2D2D2] border-t-3 border-black p-5">
                <h3 class="text-lg mb-2 text-black font-bebas font-normal uppercase">{item.title}</h3>
                <p class="text-xs leading-relaxed mb-4 text-black">{item.note}</p>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs uppercase tracking-widest font-bold text-[#00B8FF]"
                >
                  VIEW ON X →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CREATIVE DIAGNOSTICS ── -->
    <section class="bg-black border-b-4 border-[#4D4D4D]">
      <div class="container py-24 md:py-32">
        <div class="grid gap-6 lg:grid-cols-[0.7fr_1.3fr] reveal">
          <div>
            <span class="section-label mb-4 inline-block">System Specs</span>
            <h2 class="font-display font-bebas text-[var(--text-h2)] font-normal uppercase leading-[0.9] text-white">
              CREATIVE<br/>DIAGNOSTICS
            </h2>
          </div>
          <div class="bg-black border-3 border-black shadow-[4px_4px_0_#00B8FF] overflow-hidden">
            <div class="bg-[#D2D2D2] border-b-3 border-black px-4 py-3">
              <span class="font-mono text-xs uppercase tracking-widest font-bold text-black font-space-mono">/usr/tyler/creative_profile</span>
            </div>
            <dl class="grid gap-px bg-black">
              <div class="bg-[#D2D2D2] p-4">
                <dt class="font-mono text-xs uppercase tracking-widest mb-1 text-black font-space-mono">CAMERA</dt>
                <dd class="font-mono text-sm font-bold text-black font-space-mono">Sony Alpha ZV-E10</dd>
              </div>
              <div class="bg-[#D2D2D2] p-4">
                <dt class="font-mono text-xs uppercase tracking-widest mb-1 text-black font-space-mono">EDIT STACK</dt>
                <dd class="font-mono text-sm font-bold text-black font-space-mono">CapCut + desktop timeline work</dd>
              </div>
              <div class="bg-[#D2D2D2] p-4">
                <dt class="font-mono text-xs uppercase tracking-widest mb-1 text-black font-space-mono">STYLE</dt>
                <dd class="font-mono text-sm font-bold text-black font-space-mono">Real-life frames, shallow depth, documentary texture</dd>
              </div>
              <div class="bg-[#D2D2D2] p-4">
                <dt class="font-mono text-xs uppercase tracking-widest mb-1 text-black font-space-mono">RULE</dt>
                <dd class="font-mono text-sm font-bold text-[#00B8FF] font-space-mono">No stock. No AI imagery. No fake filler.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CONNECT ── -->
    <section class="bg-black">
      <div class="container py-24 md:py-32">
        <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center reveal">
          <div>
            <span class="section-label mb-3 inline-block">Signal Transmit</span>
            <h2 class="font-display mb-4 font-bebas text-[var(--text-h2)] font-normal uppercase leading-[0.9] text-white">
              CONNECT<br/>CHANNELS
            </h2>
            <p class="max-w-2xl leading-relaxed text-[#D2D2D2]">
              The live creative stream stays on social. This archive stays curated and media-truthful.
            </p>
          </div>
          <div class="flex flex-wrap gap-4">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class={link.primary ? 'btn-primary' : 'btn-ghost'}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── LIGHTBOX ── -->
    <dialog
      id="vault-lightbox"
      class="m-0 h-screen w-screen max-w-none p-0 text-white bg-black/97 border-3 border-black"
    >
      <div class="grid min-h-screen place-items-center p-4">
        <div class="w-full max-w-[56rem]">
          <div class="flex items-center justify-between gap-4 mb-3">
            <span
              id="lightbox-meta"
              class="font-space-mono text-[0.7rem] uppercase tracking-[0.15em] bg-[#00B8FF] text-white border-2 border-black px-3 py-1 font-bold"
            >PHOTO</span>
            <button
              id="lightbox-close"
              type="button"
              class="font-space-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] bg-[#00B8FF] text-white border-2 border-black px-3 py-1 cursor-pointer"
            >
              CLOSE
            </button>
          </div>
          <img
            id="lightbox-image"
            src=""
            alt=""
            class="w-full max-h-[70vh] object-contain border-3 border-black bg-[#D2D2D2]"
          />
          <h3
            id="lightbox-title"
            class="mt-4 font-bebas font-normal uppercase text-white text-[1.75rem]"
          ></h3>
        </div>
      </div>
    </dialog>
  </main>

  <Footer />

  <script>
    const dialog = document.getElementById('vault-lightbox') as HTMLDialogElement | null;
    const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const title = document.getElementById('lightbox-title');
    const meta = document.getElementById('lightbox-meta');
    const close = document.getElementById('lightbox-close');

    document.querySelectorAll('.vault-card').forEach((card) => {
      card.addEventListener('click', () => {
        if (!dialog || !image) return;
        const src = card.getAttribute('data-lightbox-src') ?? '';
        image.src = src;
        image.alt = card.getAttribute('data-lightbox-title') ?? '';
        if (title) title.textContent = card.getAttribute('data-lightbox-title') ?? '';
        if (meta) meta.textContent = card.getAttribute('data-lightbox-meta') ?? '';
        dialog.showModal();
      });
    });

    close?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>