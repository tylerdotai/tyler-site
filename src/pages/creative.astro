---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const photoWork = [
  {
    label: 'Homestead',
    title: 'Garden cat.',
    href: 'https://x.com/tylerdotai/status/2069166572497776894?s=46&t=g8NfuQQ5IY2YsrcRkoEJGw',
    image: '/assets/creative/day1-cat-garden.jpg',
    alt: 'Cream-colored cat lying in grass outdoors',
    size: 'small',
  },
  {
    label: 'Homestead',
    title: 'Backyard chickens.',
    href: 'https://x.com/tylerdotai/status/2069166572497776894?s=46&t=g8NfuQQ5IY2YsrcRkoEJGw',
    image: '/assets/creative/day1-chickens-alt.jpg',
    alt: 'Backyard chickens behind a chain-link fence',
    size: 'large',
  },
  {
    label: 'Roadside',
    title: 'Press the shutter and see what happens.',
    href: 'https://x.com/tylerdotai/status/2069524641077494222?s=46&t=g8NfuQQ5IY2YsrcRkoEJGw',
    image: '/assets/creative/day2-gas-station.jpg',
    alt: 'Gas station exterior shot',
    size: 'large',
  },
];
---

<BaseLayout
  title="Creative"
  description="Selected Sony ZV-E10 photos and videos by Tyler Delano."
>
  <Header />

  <main>
    <!-- Portfolio hero -->
    <section class="border-b border-[#2A2A2A]">
      <div class="container py-16 md:py-24">
        <div class="grid lg:grid-cols-12 gap-10 items-end">
          <div class="lg:col-span-5">
            <p class="section-label mb-5">Photo + video</p>
            <h1 class="font-serif text-6xl md:text-8xl leading-[0.9] mb-6">
              Selected<br />field notes.
            </h1>
            <p class="text-lg md:text-xl text-[#888888] max-w-xl leading-relaxed">
              A selected archive of stills and clips — portrait work, homestead frames, roadside light, and small moments worth keeping.
            </p>
          </div>

          <figure class="lg:col-span-7 lg:-mb-10">
            <img
              src="/assets/creative/tyler-portrait.jpg"
              alt="Extreme close-up portrait of Tyler Delano looking directly into the camera"
              loading="eager"
              decoding="async"
              class="w-full h-[560px] object-cover rounded"
            />
            <figcaption class="mt-3 flex items-center justify-between gap-4 text-sm text-[#888888]">
              <span>Close portrait — selected archive.</span>
              <span class="font-mono text-xs">SONY ALPHA ZV-E10</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Photo showcase -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-8 mb-12">
          <p class="section-label lg:col-span-3">Photos</p>
          <div class="lg:col-span-9">
            <h2 class="font-serif text-4xl md:text-5xl mb-4">Not a feed. A cut.</h2>
            <p class="text-[#888888] max-w-2xl leading-relaxed">
              A tight cut of the strongest frames: portrait, homestead, and roadside light.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {photoWork.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`${item.size === 'large' ? 'lg:col-span-2' : ''} group block overflow-hidden rounded border border-[#2A2A2A] bg-[#1A1A1A]`}
            >
              <img
                src={item.image}
                alt={item.alt}
                loading="eager"
                decoding="async"
                class={`${item.size === 'large' ? 'h-[420px]' : 'h-[260px]'} w-full object-contain bg-[#0E0E0E] transition-opacity duration-150 group-hover:opacity-85`}
              />
              <div class="p-4 border-t border-[#2A2A2A]">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#C9A84C] mb-1">{item.label}</p>
                <h3 class="font-serif text-2xl leading-tight">{item.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Video showcase -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="grid lg:grid-cols-12 gap-8 mb-10">
          <p class="section-label lg:col-span-3">Video</p>
          <div class="lg:col-span-9">
            <h2 class="font-serif text-4xl md:text-5xl mb-4">Motion pieces.</h2>
            <p class="text-[#888888] max-w-2xl leading-relaxed">
              Short clips shot on the Sony Alpha ZV-E10 and edited for social. Embedded here as selected work, not a feed dump.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <article class="border border-[#2A2A2A] rounded overflow-hidden bg-[#1A1A1A]">
            <video
              controls
              preload="metadata"
              class="w-full"
              poster="/assets/creative/video-preview.jpg"
            >
              <source src="/assets/creative/day3-kitchen-light.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
            <div class="p-5">
              <p class="section-label mb-2">Kitchen light</p>
              <h3 class="font-serif text-2xl">Natural kitchen light + Dr Pepper.</h3>
              <p class="mt-2 text-sm text-[#888888]">Wide, medium, close — one frame at a time.</p>
              <a
                href="https://x.com/tylerdotai/status/2069840988256841871?s=46&t=g8NfuQQ5IY2YsrcRkoEJGw"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm text-[#888888] hover:text-[#C9A84C] transition-colors"
              >
                View original post →
              </a>
            </div>
          </article>

          <article class="border border-[#2A2A2A] rounded overflow-hidden bg-[#1A1A1A]">
            <video
              controls
              preload="metadata"
              class="w-full"
              poster="/assets/creative/video2-preview.jpg"
            >
              <source src="/assets/creative/god-bless-usa.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
            <div class="p-5">
              <p class="section-label mb-2">God bless the USA</p>
              <h3 class="font-serif text-2xl">Shot on Sony Alpha ZV-E10. Edited in CapCut.</h3>
              <a
                href="https://x.com/tylerdotai/status/2069950589060936108?s=46&t=g8NfuQQ5IY2YsrcRkoEJGw"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm text-[#888888] hover:text-[#C9A84C] transition-colors"
              >
                View original post →
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Social CTA -->
    <section class="section">
      <div class="container text-center">
        <p class="text-[#888888] mb-4">New photos and clips post socially. This page stays curated.</p>
        <a href="https://x.com/tylerdotai" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Follow on X
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
