---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const nextEvent = {
  title: 'Agent Builders Meetup — June',
  date: 'Thursday, June 26 · 7:00 PM',
  location: 'ClawPlex HQ, DFW',
  description: 'Monthly in-person meetup. This month: live agent demos + open build time. Bring your project.',
  url: 'https://lu.ma/clawplex',
};

const pastEvents = [
  {
    node: 'DFW Node 06 — Hermes',
    date: 'JUNE 10, 2026',
    location: 'Spark Coworking, Arlington',
    photos: [
      { src: '/assets/community/node-06-hermes-01.webp', alt: 'DFW Node 06 — Hermes at Spark Coworking Arlington' },
      { src: '/assets/community/node-06-hermes-02.webp', alt: 'DFW Node 06 — Hermes at Spark Coworking Arlington' },
      { src: '/assets/community/node-06-hermes-03.webp', alt: 'DFW Node 06 — Hermes at Spark Coworking Arlington' },
    ],
    description: 'Builders filled Spark Coworking in Arlington for a deep look at Hermes Agent — live demos, debugging, and a real conversation about what it actually means to ship an agent that gets better the more you use it.',
  },
  {
    node: 'DFW Node 05 — Claude Tools',
    date: 'JUNE 3, 2026',
    location: 'Office Evolution, Southlake',
    photos: [
      { src: '/assets/community/node-05-claude-tools-01.webp', alt: 'DFW Node 05 — Claude Tools at Office Evolution Southlake' },
    ],
    description: '30+ DFW builders gathered for an honest conversation about the AI tools actually on their desks — Cursor, Claude Code, OpenCode, OpenAI, Hermes, OpenClaw, and more. No slides, no pitches.',
  },
  {
    node: 'DFW Node 04 — Frisco',
    date: 'MAY 13, 2026',
    location: '25N Coworking, Frisco',
    photos: [
      { src: '/assets/community/node-04-frisco-01.jpeg', alt: 'DFW Node 04 — Frisco at 25N Coworking' },
    ],
    description: 'Claude In The Wild Meetup. Informal session where people are putting Claude to work on real projects and sharing what actually helps in day-to-day use. Heavy token users showing workflows, automations, and practical setups.',
  },
  {
    node: 'DFW Node 03 — Fort Worth',
    date: 'MAY 6, 2026',
    location: 'Fort Worth',
    photos: [
      { src: '/assets/community/node-03-fort-worth-01.png', alt: 'DFW Node 03 — Fort Worth Mac Mini OpenClaw Workshop' },
    ],
    description: 'Hands-on Mac Mini + OpenClaw install workshop. Live demo of the Mac Mini OpenClaw setup. Great networking and builders of all levels.',
  },
  {
    node: 'ClawCon DFW',
    date: '2026',
    location: 'DFW',
    photos: [
      { src: '/assets/community/clawcon-01.webp', alt: 'ClawCon DFW — inaugural AI builders conference' },
    ],
    description: 'The inaugural ClawCon — DFW\'s first AI builders conference. A full day of live demos, agent builds, and honest conversations about what\'s actually working in AI right now.',
  },
];
---

<BaseLayout
  title="Community"
  description="Agent Builders Club — DFW AI community. 600+ members, 6 physical nodes, learning to build with AI."
>
  <Header />

  <main>

    <!-- ── STATS ROW ── -->
    <section style="background:#D2D2D2; border-bottom: 4px solid #000000;">
      <div class="container py-16 md:py-24">
        <div class="grid grid-cols-3 gap-0 text-center">
          <div class="brutal-stat" style="border-right: 4px solid #000000;">
            <span class="stat-number">600+</span>
            <span class="stat-label">Members</span>
          </div>
          <div class="brutal-stat" style="border-right: 4px solid #000000;">
            <span class="stat-number">6</span>
            <span class="stat-label">Nodes</span>
          </div>
          <div class="brutal-stat">
            <span class="stat-number">Monthly</span>
            <span class="stat-label">Meetups</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── ABOUT ── -->
    <section style="background:#D2D2D2; border-bottom: 4px solid #000000;">
      <div class="container py-24 md:py-32">
        <div class="grid lg:grid-cols-[1fr_1fr_auto] gap-12 lg:gap-16 items-start">
          <!-- Left: heading -->
          <div>
            <span class="section-label mb-6 block reveal">DFW AI Community</span>
            <h1 class="font-display mb-0" style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.9; color:#000000; font-size:var(--text-h1);">
              AGENT<br/>BUILDERS<br/>CLUB
            </h1>
          </div>

          <!-- Center: text -->
          <div class="reveal">
            <p class="text-[var(--text-body)] leading-relaxed mb-5">
              Agent Builders Club started as a side project in 2026. The idea was simple: a place where people building with AI could show each other the real stuff — workflows, prompts, agent architectures, failures, wins.
            </p>
            <p class="text-[var(--text-body)] leading-relaxed mb-5">
              Not a course. Not a mastermind. Not a content play. Just people who want to build things with AI, meeting regularly to do exactly that.
            </p>
            <p class="text-[var(--text-body)] leading-relaxed mb-10">
              The community grew to 600+ across 6 physical nodes in the DFW metro. Each node is independently organized. Each has its own flavor. All of them are focused on the same thing: building.
            </p>
            <div class="flex gap-6 reveal">
              <a href="https://discord.gg/q8kEquTu3z" target="_blank" rel="noopener noreferrer" class="btn-primary">JOIN DISCORD</a>
              <a href="https://lu.ma/clawplex" target="_blank" rel="noopener noreferrer" class="btn-ghost">SEE ALL EVENTS</a>
            </div>
          </div>

          <!-- Right: mascot -->
          <div class="reveal" style="margin-top:1rem;">
            <img
              src="/assets/community/mascot-abc.jpg"
              alt="Agent Builders Club mascot"
              style="max-height:280px; width:auto; display:block;"
              class="brutal-shadow"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ── PAST EVENTS GALLERY ── -->
    <section style="background:#D2D2D2; border-bottom: 4px solid #000000;">
      <div class="container py-24 md:py-32">
        <div class="mb-12">
          <span class="section-label mb-4 block reveal">DFW Nodes · 2026</span>
          <h2 class="font-display reveal" style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.9; color:#000000; font-size:var(--text-h2);">
            PAST<br/>EVENTS
          </h2>
        </div>

        <div class="space-y-20">

          {pastEvents.map((event) => (
            <div class="reveal">
              <div class="flex flex-col md:flex-row gap-6 mb-6">
                {event.photos.map((photo) => (
                  <div class="card" style="flex:1; box-shadow: 4px 4px 0 #00B8FF; position:relative; overflow:hidden;">
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      class="w-full h-64 object-cover"
                      loading="lazy"
                    />
                    <!-- Dark ink label overlay on photo -->
                    <div style="position:absolute; bottom:0; left:0; right:0; background:#000000; padding:0.75rem 1rem; border-top:3px solid #000000;">
                      <span class="font-mono text-xs uppercase tracking-widest font-bold" style="color:#FFFFFF; font-family:'Space Mono',monospace;">
                        {event.node}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <!-- Dark ink description container with white text -->
              <div style="background:#000000; border:3px solid #000000; padding:1.25rem;">
                <div class="flex flex-wrap gap-4 items-center mb-2">
                  <span class="font-mono text-xs uppercase tracking-widest font-bold" style="color:#00B8FF; font-family:'Space Mono',monospace;">{event.node}</span>
                  <span class="font-mono text-xs" style="color:#D2D2D2;">·</span>
                  <span class="font-mono text-xs" style="color:#D2D2D2; font-family:'Space Mono',monospace;">{event.date}</span>
                  <span class="font-mono text-xs" style="color:#D2D2D2;">·</span>
                  <span class="font-mono text-xs" style="color:#D2D2D2; font-family:'Space Mono',monospace;">{event.location}</span>
                </div>
                <p class="text-sm leading-relaxed" style="color:#D2D2D2;">
                  {event.description}
                </p>
              </div>
            </div>
          ))}

        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
