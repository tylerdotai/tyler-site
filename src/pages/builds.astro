---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Builds"
  description="Open-source AI tools, agent harnesses, and research pipelines. Built by Tyler Delano."
>
  <Header />

  <main>
    <section class="section border-b border-[#E8E4DC]">
      <div class="container">
        <p class="section-label mb-4">Open source</p>
        <h1 class="text-5xl font-serif mb-4">What I build.</h1>
        <p class="text-lg text-[#6B6B6B] max-w-2xl">
          AI tools, agent harnesses, and research pipelines. Most of it's open.
          The stuff that isn't is because I'm still figuring it out.
        </p>
      </div>
    </section>

    <section class="section border-b border-[#E8E4DC]">
      <div class="container">
        <div class="space-y-8">
          <!-- Singularity -->
          <article class="grid md:grid-cols-3 gap-8 items-start">
            <div>
              <h2 class="font-serif text-2xl mb-2">Singularity</h2>
              <div class="flex flex-wrap gap-2 mb-3">
                {['Bun', 'TypeScript', 'SQLite'].map(t => (
                  <span class="text-xs font-mono bg-[#F7F4EE] text-[#6B6B6B] px-2 py-1 rounded">{t}</span>
                ))}
              </div>
            </div>
            <div class="md:col-span-2">
              <p class="text-[#6B6B6B] mb-4">
                Provider-neutral AI agent harness. Swap between OpenAI, Anthropic, Ollama,
                or anything with an OpenAI-compatible API — the agent logic stays the same.
                Structured tool calling, JSON state, SQLite persistence. Built for agents that
                need to run reliably without a cloud provider.
              </p>
              <a
                href="https://github.com/tylerdotai/singularity"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                View on GitHub
              </a>
            </div>
          </article>

          <div class="border-t border-[#E8E4DC]"></div>

          <!-- Agent Loop System -->
          <article class="grid md:grid-cols-3 gap-8 items-start">
            <div>
              <h2 class="font-serif text-2xl mb-2">Agent Loop System</h2>
              <div class="flex flex-wrap gap-2 mb-3">
                {['Python', 'JSON', 'SQLite'].map(t => (
                  <span class="text-xs font-mono bg-[#F7F4EE] text-[#6B6B6B] px-2 py-1 rounded">{t}</span>
                ))}
              </div>
            </div>
            <div class="md:col-span-2">
              <p class="text-[#6B6B6B] mb-4">
                Closed-loop agent harness with structured outputs and step-by-step reasoning.
                Python-first. Define your agent's tools in JSON, wire them up, and get
                traceable, auditable agent runs. Good for agents that need to justify
                every decision.
              </p>
              <a
                href="https://github.com/tylerdotai/agent-loop-system"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                View on GitHub
              </a>
            </div>
          </article>

          <div class="border-t border-[#E8E4DC]"></div>

          <!-- AIAgainstParkinson -->
          <article class="grid md:grid-cols-3 gap-8 items-start">
            <div>
              <h2 class="font-serif text-2xl mb-2">AIAgainstParkinson</h2>
              <div class="flex flex-wrap gap-2 mb-3">
                {['Python', 'PubMed', 'MiniMax'].map(t => (
                  <span class="text-xs font-mono bg-[#F7F4EE] text-[#6B6B6B] px-2 py-1 rounded">{t}</span>
                ))}
              </div>
            </div>
            <div class="md:col-span-2">
              <p class="text-[#6B6B6B] mb-4">
                Daily automated research pipeline for Parkinson's disease. Every morning,
                a cron job pulls the latest PubMed papers, generates plain-language summaries
                in English and Spanish, and delivers them — automatically. No paywall. No algorithm.
                Just research, delivered.
              </p>
              <a
                href="https://github.com/tylerdotai/parkinson-research"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                View on GitHub
              </a>
            </div>
          </article>

          <div class="border-t border-[#E8E4DC]"></div>

          <!-- Voice Agent -->
          <article class="grid md:grid-cols-3 gap-8 items-start">
            <div>
              <h2 class="font-serif text-2xl mb-2">Voice Agent</h2>
              <div class="flex flex-wrap gap-2 mb-3">
                {['Python', 'WebRTC', 'LLM'].map(t => (
                  <span class="text-xs font-mono bg-[#F7F4EE] text-[#6B6B6B] px-2 py-1 rounded">{t}</span>
                ))}
              </div>
            </div>
            <div class="md:col-span-2">
              <p class="text-[#6B6B6B] mb-4">
                Real-time voice agent using WebRTC and a local LLM. No cloud API for the
                voice leg — the audio stays local. Built for agents that need to talk
                without latency or dependency on a third-party voice API.
              </p>
              <a
                href="https://github.com/tylerdotai/voice-agent"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ghost text-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                View on GitHub
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
