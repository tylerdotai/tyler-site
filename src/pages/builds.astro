---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    name: 'Singularity',
    description: 'Provider-neutral AI agent harness. Swap between OpenAI, Anthropic, Ollama, or anything with an OpenAI-compatible API — the agent logic stays the same. Structured tool calling, JSON state, SQLite persistence. Built for agents that need to run reliably without a cloud provider.',
    tech: ['Bun', 'TypeScript', 'SQLite'],
    url: 'https://github.com/tylerdotai/singularity',
  },
  {
    name: 'Agent Loop System',
    description: 'Closed-loop agent harness with structured outputs and step-by-step reasoning. Python-first. Define your agent\'s tools in JSON, wire them up, and get traceable, auditable agent runs. Good for agents that need to justify every decision.',
    tech: ['Python', 'JSON', 'SQLite'],
    url: 'https://github.com/tylerdotai/agent-loop-system',
  },
  {
    name: 'AIAgainstParkinson',
    description: 'Daily automated research pipeline for Parkinson\'s disease. Every morning, a cron job pulls the latest PubMed papers, generates plain-language summaries in English and Spanish, and delivers them — automatically. No paywall. No algorithm. Just research, delivered.',
    tech: ['Python', 'PubMed', 'MiniMax'],
    url: 'https://github.com/tylerdotai/parkinson-research',
  },
  {
    name: 'Voice Agent',
    description: 'Real-time voice agent using WebRTC and a local LLM. No cloud API for the voice leg — the audio stays local. Built for agents that need to talk without latency or dependency on a third-party voice API.',
    tech: ['Python', 'WebRTC', 'LLM'],
    url: 'https://github.com/tylerdotai/voice-agent',
  },
];
---

<BaseLayout
  title="Builds"
  description="Open-source AI tools, agent harnesses, and research pipelines. Built by Tyler Delano."
>
  <Header />

  <main>
    <!-- Header -->
    <section class="border-b-4 border-black" style="background:#FFFDF0;">
      <div class="container py-16 md:py-24">
        <p class="font-mono text-sm uppercase tracking-widest mb-4" style="color:#1A1AFF;">Open source</p>
        <h1 class="text-6xl md:text-8xl font-display leading-none mb-6" style="color:#1A1AFF; font-family:'Bebas Neue', sans-serif;">
          WHAT<br/>I BUILD.
        </h1>
        <p class="text-lg max-w-xl leading-relaxed" style="color:#1A1AFF;">
          AI tools, agent harnesses, and research pipelines. Most of it's open. The stuff that isn't is because I'm still figuring it out.
        </p>
      </div>
    </section>

    <!-- Project Grid -->
    <section class="py-16 md:py-24" style="background:#FFFDF0;">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-0">
          {projects.map((project, i) => (
            <article
              class="brutal-card"
              style={i % 2 === 0 ? 'border-right-4 border-b-4' : 'border-left-4 border-b-4'}
            >
              <div class="p-8 md:p-10">
                <!-- Title -->
                <h2 class="text-4xl md:text-5xl font-display mb-6" style="color:#1A1AFF; font-family:'Bebas Neue', sans-serif;">
                  {project.name}
                </h2>

                <!-- Tech chips -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.tech.map(t => (
                    <span class="tech-chip">{t}</span>
                  ))}
                </div>

                <!-- Description -->
                <p class="text-base leading-relaxed mb-8" style="color:#1A1AFF;">
                  {project.description}
                </p>

                <!-- Link -->
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="brutal-link"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  VIEW ON GITHUB
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .font-display {
    font-family: 'Bebas Neue', 'Arial Black', sans-serif;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .font-mono {
    font-family: 'Space Mono', ui-monospace, monospace;
  }

  .brutal-card {
    position: relative;
    border-color: #1A1AFF;
    border-style: solid;
    border-width: 3px;
    background: #FFFDF0;
    box-shadow: 6px 6px 0 #1A1AFF;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }

  .brutal-card:hover {
    box-shadow: 10px 10px 0 #1A1AFF;
    transform: translate(-2px, -2px);
  }

  .tech-chip {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.6rem;
    background: #FFFF00;
    color: #1A1AFF;
    border: 2px solid #1A1AFF;
    font-weight: 700;
  }

  .brutal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #1A1AFF;
    border: 3px solid #1A1AFF;
    padding: 0.6rem 1rem;
    background: #FFF;
    box-shadow: 4px 4px 0 #1A1AFF;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }

  .brutal-link:hover {
    background: #1A1AFF;
    color: #FFFDF0;
    box-shadow: 6px 6px 0 #FFFF00;
    transform: translate(-1px, -1px);
  }

  /* Bottom border on last row items */
  .grid > article:nth-last-child(-n+2) {
    border-bottom-width: 3px;
  }
</style>
