---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Home"
  description="Tinkerer of AI, creative guy, collaborative community builder. Building in the open."
>
  <Header />

  <main>
    <!-- ── HERO ── -->
    <section style="background:#000000;">
      <div class="container py-24 md:py-40">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <!-- Text -->
          <div>
            <span class="section-label mb-6 block reveal">TYLER DELANO</span>
            <h1 class="text-[var(--text-hero)] font-display leading-[0.9] tracking-[0.01em] mb-8 reveal" style="color:#FFFFFF; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase;">
              TINKERER<br/>OF AI
            </h1>
            <p class="text-[var(--text-body)] text-lg mb-10 max-w-lg leading-relaxed reveal" style="color:#D2D2D2;">
              Running the Agent Builders Club — a DFW community of 600+ people learning to build with AI.
            </p>
            <div class="flex flex-wrap gap-4 reveal">
              <a href="/builds" class="btn-primary">SEE WHAT I BUILD</a>
              <a href="/community" class="btn-ghost">AGENT BUILDERS CLUB</a>
            </div>
          </div>

          <!-- Photo -->
          <div class="relative reveal">
            <div style="border: 3px solid #FFFFFF; box-shadow: 6px 6px 0 #007AFF;">
              <img
                src="/assets/creative/tyler-portrait-bedroom.jpg"
                alt="Tyler Delano — ZV-E10 portrait, cream walls, gold hoop earring, black t-shirt"
                class="w-full h-auto block"
                width="600"
                height="750"
                loading="eager"
              />
            </div>
            <!-- Stat pill -->
            <div class="brutal-stat absolute -bottom-4 -right-4 px-5 py-3">
              <span class="stat-number">600+</span>
              <span class="stat-label">COMMUNITY MEMBERS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── THREE PILLARS ── -->
    <section class="border-b-4 border-[#000000]">
      <div class="container py-24 md:py-32">
        <div class="grid md:grid-cols-3 gap-6">

          <!-- Build -->
          <div class="card p-8 reveal">
            <div class="mb-6">
              <span class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF; font-family:'Space Mono',monospace;">01 / BUILD</span>
            </div>
            <h3 class="text-4xl mb-5" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              AGENTS<br/>&amp; TOOLS
            </h3>
            <p class="text-sm mb-8 leading-relaxed" style="color:#000000;">
              Provider-neutral AI agent harnesses, closed-loop systems, and research pipelines. Bun, TypeScript, Python — whatever gets the job done.
            </p>
            <a href="/builds" class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF;">VIEW ALL BUILDS →</a>
          </div>

          <!-- Community -->
          <div class="card p-8 reveal">
            <div class="mb-6">
              <span class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF; font-family:'Space Mono',monospace;">02 / COMMUNITY</span>
            </div>
            <h3 class="text-4xl mb-5" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              AGENT<br/>BUILDERS CLUB
            </h3>
            <p class="text-sm mb-8 leading-relaxed" style="color:#000000;">
              600+ members across 6 DFW locations learning to build AI-powered workflows. No fluff. Just builders showing each other what works.
            </p>
            <a href="/community" class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF;">JOIN THE CLUB →</a>
          </div>

          <!-- Creative -->
          <div class="card p-8 reveal">
            <div class="mb-6">
              <span class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF; font-family:'Space Mono',monospace;">03 / CREATE</span>
            </div>
            <h3 class="text-4xl mb-5" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              FILM<br/>&amp; STORY
            </h3>
            <p class="text-sm mb-8 leading-relaxed" style="color:#000000;">
              30 days with the Sony ZV-E10. Every clip is a real moment. No crew. No script. Just a camera and whatever showed up that day.
            </p>
            <a href="/creative" class="font-mono text-xs uppercase tracking-widest" style="color:#007AFF;">SEE THE FOOTAGE →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- ── ABOUT ── -->
    <section class="border-b-4 border-[#000000]">
      <div class="container py-24 md:py-32">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <!-- Photo -->
          <div class="relative reveal">
            <div style="border: 3px solid #000000; box-shadow: 6px 6px 0 #007AFF;">
              <img
                src="/assets/creative/tyler-extreme-closeup.jpg"
                alt="Tyler Delano — extreme closeup portrait"
                class="w-full block"
                width="600"
                height="750"
                loading="lazy"
              />
            </div>
            <!-- Year badge -->
            <div class="absolute -top-4 -left-4 px-4 py-3" style="background:#000000; border: 2px solid #000000; box-shadow: 4px 4px 0 #007AFF;">
              <span class="font-display text-2xl" style="color:#FFFFFF; font-family:'Bebas Neue',sans-serif; font-weight:400;">2024</span>
              <span class="font-body text-xs block" style="color:#D2D2D2;">YEAR OF THE AGENT</span>
            </div>
          </div>

          <!-- Text -->
          <div class="reveal">
            <span class="section-label mb-4 block">HOW I GOT HERE</span>
            <h2 class="text-[var(--text-h2)] font-display mb-8" style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95; color:#FFFFFF;">
              FROM PIP TO<br/>TINKERER
            </h2>
            <div class="space-y-5 mb-10">
              <p class="text-[var(--text-body)] leading-relaxed">
                March 2024, Amazon put me on a Performance Improvement Plan. Three months to turn it around or get cut. Instead of panic-applying to jobs, I got curious about AI agents.
              </p>
              <p class="text-[var(--text-body)] leading-relaxed">
                Built a crew of AI subagents to handle the PIP tasks for me. They didn't save my job — but they showed me what was actually possible when you stop using AI as a chatbot and start treating it like a workforce.
              </p>
              <p class="text-[var(--text-body)] leading-relaxed">
                Got rated "Exceeds High Bar" on my mid-year review. Got a raise. Decided: this is the thing. Let's go all in.
              </p>
            </div>
            <!-- Stats row -->
            <div class="flex gap-8">
              <div>
                <span class="stat-number">600+</span>
                <span class="stat-label">Members</span>
              </div>
              <div style="border-left: 3px solid #000000; padding-left: 2rem;">
                <span class="stat-number">6</span>
                <span class="stat-label">DFW Nodes</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── RECENT BUILDS ── -->
    <section class="border-b-4 border-[#000000]">
      <div class="container py-24 md:py-32">
        <div class="flex flex-wrap items-end justify-between gap-6 mb-12 reveal">
          <div>
            <span class="section-label mb-4 block">RECENT BUILDS</span>
            <h2 class="font-display" style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95; color:#000000; font-size:var(--text-h2);">
              TOOLS, AGENTS<br/>&amp; PIPELINES
            </h2>
          </div>
          <a href="/builds" class="btn-ghost">ALL BUILDS →</a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">

          <a href="https://github.com/tylerdotai/singularity" target="_blank" rel="noopener noreferrer" class="card p-6 group reveal">
            <div class="mb-4">
              <span class="font-mono text-xs uppercase tracking-widest px-2 py-1" style="background:#000000; color:#007AFF; font-family:'Space Mono',monospace;">BUN · TS</span>
            </div>
            <h3 class="text-3xl mb-3" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              SINGULARITY
            </h3>
            <p class="text-sm mb-6 leading-relaxed" style="color:#000000;">
              Provider-neutral AI agent harness. Runs on your own API keys. Bun, TypeScript, SQLite.
            </p>
            <span class="font-mono text-xs" style="color:#007AFF;">github.com/tylerdotai/singularity</span>
          </a>

          <a href="https://github.com/tylerdotai/agent-loop-system" target="_blank" rel="noopener noreferrer" class="card p-6 group reveal">
            <div class="mb-4">
              <span class="font-mono text-xs uppercase tracking-widest px-2 py-1" style="background:#000000; color:#007AFF; font-family:'Space Mono',monospace;">PYTHON</span>
            </div>
            <h3 class="text-3xl mb-3" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              AGENT LOOP<br/>SYSTEM
            </h3>
            <p class="text-sm mb-6 leading-relaxed" style="color:#000000;">
              Closed-loop agent harness with Python and JSON. Structured outputs, step-by-step reasoning.
            </p>
            <span class="font-mono text-xs" style="color:#007AFF;">github.com/tylerdotai/agent-loop-system</span>
          </a>

          <a href="https://github.com/tylerdotai/parkinson-research" target="_blank" rel="noopener noreferrer" class="card p-6 group reveal">
            <div class="mb-4">
              <span class="font-mono text-xs uppercase tracking-widest px-2 py-1" style="background:#D2D2D2; color:#000000; font-family:'Space Mono',monospace; border: 2px solid #000000;">RESEARCH</span>
            </div>
            <h3 class="text-3xl mb-3" style="color:#000000; font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.95;">
              AIAGAINST<br/>PARKINSON
            </h3>
            <p class="text-sm mb-6 leading-relaxed" style="color:#000000;">
              Daily AI research pipeline. PubMed → summary → EN/ES delivery. Every day, automatically.
            </p>
            <span class="font-mono text-xs" style="color:#007AFF;">github.com/tylerdotai/parkinson-research</span>
          </a>

        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="border-b-4 border-[#000000]">
      <div class="container py-24 md:py-32">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="reveal">
            <h2 class="font-display mb-8" style="font-family:'Bebas Neue',sans-serif; font-weight:400; text-transform:uppercase; line-height:0.9; color:#000000; font-size:var(--text-h2);">
              WANT TO<br/>BUILD WITH ME?
            </h2>
            <p class="text-[var(--text-body)] text-lg mb-10 max-w-lg leading-relaxed" style="color:#000000;">
              Join the Agent Builders Club — 600+ DFW builders learning to ship AI-powered workflows. No hype. Just hands-on work and real connections.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/community" class="btn-primary">JOIN AGENT BUILDERS CLUB</a>
              <a href="/builds" class="btn-ghost">SEE MY PROJECTS</a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 reveal">
            <div class="p-6" style="background:#FFFFFF; border: 3px solid #000000; box-shadow: 4px 4px 0 #007AFF;">
              <span class="font-mono font-bold text-5xl block" style="color:#000000; font-family:'Space Mono',monospace;">600+</span>
              <span class="font-body text-xs mt-2 block" style="color:#000000; text-transform:uppercase; letter-spacing:0.1em;">Members</span>
            </div>
            <div class="p-6" style="background:#000000; border: 3px solid #000000;">
              <span class="font-mono font-bold text-5xl block" style="color:#007AFF; font-family:'Space Mono',monospace;">6</span>
              <span class="font-body text-xs mt-2 block" style="color:#D2D2D2; text-transform:uppercase; letter-spacing:0.1em;">DFW Nodes</span>
            </div>
            <div class="p-6" style="background:#000000; border: 3px solid #000000;">
              <span class="font-mono font-bold text-5xl block" style="color:#007AFF; font-family:'Space Mono',monospace;">DFW</span>
              <span class="font-body text-xs mt-2 block" style="color:#D2D2D2; text-transform:uppercase; letter-spacing:0.1em;">Metro Area</span>
            </div>
            <div class="p-6" style="background:#FFFFFF; border: 3px solid #000000; box-shadow: 4px 4px 0 #007AFF;">
              <span class="font-mono font-bold text-5xl block" style="color:#000000; font-family:'Space Mono',monospace;">2026</span>
              <span class="font-body text-xs mt-2 block" style="color:#000000; text-transform:uppercase; letter-spacing:0.1em;">Founded</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
