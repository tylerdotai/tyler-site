---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Home"
  description="Tinkerer of AI, creative guy, collaborative community builder. Building in the open."
>
  <Header />

  <main class="bg-white">
    <!-- Hero -->
    <section class="section bg-yellow border-b-3 border-black">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="section-label mb-6 block border-2 border-black shadow-[4px_4px_0_#000]">TYLER DELANO</span>
            <h1 class="font-display text-black mt-4 mb-6" style="font-size: clamp(4rem, 12vw, 10rem); line-height: 0.9;">
              TINKERER<br/>OF AI
            </h1>
            <p class="text-lg text-black/70 mb-8 max-w-lg font-body leading-relaxed">
              IT Support Associate by day. AI agent builder by night. Running the Agent Builders Club — a DFW community of 600+ people learning to build with AI.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/builds" class="btn-primary bg-yellow text-black border-black shadow-[6px_6px_0_#000] hover:translate-x-[-3px] hover:translate-y-[-3px] hover:shadow-[9px_9px_0_#000]">
                SEE WHAT I BUILD
              </a>
              <a href="/community" class="btn-ghost bg-white text-black border-black shadow-[6px_6px_0_#000] hover:bg-yellow hover:translate-x-[-3px] hover:translate-y-[-3px] hover:shadow-[9px_9px_0_#000]">
                AGENT BUILDERS CLUB
              </a>
            </div>
          </div>
          <div class="relative">
            <img
              src="/assets/creative/tyler-portrait-bedroom.jpg"
              alt="Tyler Delano portrait — cream walls, gold hoop earring, black t-shirt, looking directly at camera"
              class="neo-image w-full h-auto"
            />
            <div class="absolute -bottom-4 -right-4 bg-blue text-white px-4 py-2 border-3 border-black shadow-[6px_6px_0_#000]">
              <span class="font-display text-2xl">600+</span>
              <span class="font-body text-xs block">COMMUNITY MEMBERS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Build / Community / Create Cards -->
    <section class="section bg-surface">
      <div class="container">
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Build Card -->
          <div class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000]">
            <div class="bg-blue text-white px-3 py-1 inline-block mb-4 border-2 border-black">
              <span class="font-body text-xs font-bold tracking-wider">01 / BUILD</span>
            </div>
            <h3 class="font-display text-4xl text-black mb-4">AGENTS &<br/>TOOLS</h3>
            <p class="text-black/70 font-body text-sm mb-6 leading-relaxed">
              Provider-neutral AI agent harnesses, closed-loop systems, and research pipelines. Bun, TypeScript, Python — whatever gets the job done.
            </p>
            <a href="/builds" class="neo-link font-body text-sm font-bold uppercase tracking-wider">VIEW ALL BUILDS →</a>
          </div>

          <!-- Community Card -->
          <div class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000]">
            <div class="bg-yellow px-3 py-1 inline-block mb-4 border-2 border-black">
              <span class="font-body text-xs font-bold tracking-wider">02 / COMMUNITY</span>
            </div>
            <h3 class="font-display text-4xl text-black mb-4">AGENT<br/>BUILDERS CLUB</h3>
            <p class="text-black/70 font-body text-sm mb-6 leading-relaxed">
              600+ members across 6 DFW locations learning to build AI-powered workflows and agents. No fluff. Just builders showing each other what works.
            </p>
            <a href="/community" class="neo-link font-body text-sm font-bold uppercase tracking-wider">JOIN THE CLUB →</a>
          </div>

          <!-- Create Card -->
          <div class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000]">
            <div class="bg-black text-white px-3 py-1 inline-block mb-4 border-2 border-black">
              <span class="font-body text-xs font-bold tracking-wider">03 / CREATE</span>
            </div>
            <h3 class="font-display text-4xl text-black mb-4">FILM &<br/>DOCUMENTARY</h3>
            <p class="text-black/70 font-body text-sm mb-6 leading-relaxed">
              30 days with the Sony ZV-E10. Every clip is a real moment. No crew. No script. Just a camera and whatever showed up that day.
            </p>
            <a href="/creative" class="neo-link font-body text-sm font-bold uppercase tracking-wider">SEE THE FOOTAGE →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- About Snippet -->
    <section class="section bg-white border-t-3 border-black">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="relative">
            <img
              src="/assets/creative/tyler-extreme-closeup.jpg"
              alt="Tyler Delano - Portrait"
              class="neo-image w-full"
            />
            <div class="absolute -top-4 -left-4 bg-yellow px-4 py-2 border-3 border-black shadow-[6px_6px_0_#000]">
              <span class="font-display text-xl">2024</span>
              <span class="font-body text-xs block">YEAR OF THE AGENT</span>
            </div>
          </div>
          <div>
            <span class="section-label mb-4 block">HOW I GOT HERE</span>
            <h2 class="font-display text-5xl md:text-6xl text-black mb-6">FROM PIP TO<br/>TINKERER</h2>
            <div class="space-y-4">
              <p class="text-black/70 font-body leading-relaxed">
                March 2024, Amazon put me on a Performance Improvement Plan. Three months to turn it around or get cut. Instead of panic-applying to jobs, I got curious about AI agents.
              </p>
              <p class="text-black/70 font-body leading-relaxed">
                Built a crew of AI subagents to handle the PIP tasks for me. They didn't save my job — but they did something better. They showed me what was actually possible when you stop using AI as a chatbot and start treating it like a workforce.
              </p>
              <p class="text-black/70 font-body leading-relaxed">
                Got rated "Exceeds High Bar" on my mid-year review. Got a raise. Decided: this is the thing. Let's go all in.
              </p>
            </div>
            <div class="grid grid-cols-2 gap-4 mt-8">
              <div class="neo-panel bg-yellow">
                <span class="font-display text-4xl">600+</span>
                <span class="font-body text-xs block mt-1">COMMUNITY MEMBERS</span>
              </div>
              <div class="neo-panel">
                <span class="font-display text-4xl">6</span>
                <span class="font-body text-xs block mt-1">DFW LOCATIONS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="section bg-surface border-t-3 border-black">
      <div class="container">
        <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
          <div>
            <span class="section-label mb-4 block">RECENT BUILDS</span>
            <h2 class="font-display text-5xl md:text-6xl text-black">TOOLS, AGENTS<br/>& PIPELINES</h2>
          </div>
          <a href="/builds" class="btn-ghost bg-white text-black border-black shadow-[6px_6px_0_#000] hover:bg-yellow">
            ALL BUILDS →
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Singularity -->
          <a href="https://github.com/tylerdotai/singularity" target="_blank" rel="noopener noreferrer" class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000] group">
            <div class="flex items-start justify-between mb-4">
              <span class="neo-badge">BUN · TS</span>
            </div>
            <h3 class="font-display text-3xl text-black mb-3 group-hover:text-blue">SINGULARITY</h3>
            <p class="text-black/70 font-body text-sm mb-4 leading-relaxed">
              Provider-neutral AI agent harness. Runs on your own API keys. Bun, TypeScript, SQLite.
            </p>
            <span class="font-mono text-xs text-black/50">github.com/tylerdotai/singularity</span>
          </a>

          <!-- Agent Loop System -->
          <a href="https://github.com/tylerdotai/agent-loop-system" target="_blank" rel="noopener noreferrer" class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000] group">
            <div class="flex items-start justify-between mb-4">
              <span class="neo-badge">PYTHON</span>
            </div>
            <h3 class="font-display text-3xl text-black mb-3 group-hover:text-blue">AGENT LOOP SYSTEM</h3>
            <p class="text-black/70 font-body text-sm mb-4 leading-relaxed">
              Closed-loop agent harness with Python and JSON. Structured outputs, step-by-step reasoning.
            </p>
            <span class="font-mono text-xs text-black/50">github.com/tylerdotai/agent-loop-system</span>
          </a>

          <!-- AIAgainstParkinson -->
          <a href="https://github.com/tylerdotai/parkinson-research" target="_blank" rel="noopener noreferrer" class="card bg-white border-3 border-black shadow-[6px_6px_0_#000] hover:translate-x-[-4px] hover:translate-y-[-4px] hover:shadow-[10px_10px_0_#000] group">
            <div class="flex items-start justify-between mb-4">
              <span class="neo-badge neo-badge-yellow">RESEARCH</span>
            </div>
            <h3 class="font-display text-3xl text-black mb-3 group-hover:text-blue">AIAGAINST<br/>PARKINSON</h3>
            <p class="text-black/70 font-body text-sm mb-4 leading-relaxed">
              Daily AI research pipeline. PubMed → summary → EN/ES delivery. Every day, automatically.
            </p>
            <span class="font-mono text-xs text-black/50">github.com/tylerdotai/parkinson-research</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Yellow CTA Block -->
    <section class="section bg-yellow border-t-3 border-black">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-5xl md:text-7xl text-black mb-6">WANT TO<br/>BUILD WITH ME?</h2>
            <p class="text-black/70 font-body text-lg mb-8 max-w-lg leading-relaxed">
              Join the Agent Builders Club — 600+ DFW builders learning to ship AI-powered workflows. No hype. Just hands-on work and real connections.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/community" class="btn-primary bg-black text-yellow border-black shadow-[6px_6px_0_#000] hover:bg-blue hover:text-white">
                JOIN AGENT BUILDERS CLUB
              </a>
              <a href="/builds" class="btn-ghost bg-yellow text-black border-black shadow-[6px_6px_0_#000] hover:bg-black hover:text-yellow">
                SEE MY PROJECTS
              </a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="neo-panel bg-white">
              <span class="font-display text-5xl">600+</span>
              <span class="font-body text-xs block mt-2">MEMBERS</span>
            </div>
            <div class="neo-panel bg-black text-white">
              <span class="font-display text-5xl">6</span>
              <span class="font-body text-xs block mt-2">PHYSICAL NODES</span>
            </div>
            <div class="neo-panel bg-black text-white">
              <span class="font-display text-5xl">DFW</span>
              <span class="font-body text-xs block mt-2">METRO AREA</span>
            </div>
            <div class="neo-panel bg-white">
              <span class="font-display text-5xl">2026</span>
              <span class="font-body text-xs block mt-2">FOUNDED</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .border-3 {
    border-width: 3px;
  }
  
  .bg-surface {
    background: var(--color-surface);
  }
  
  .bg-yellow {
    background: var(--color-yellow);
  }
  
  .text-yellow {
    color: var(--color-yellow);
  }
  
  .hover\:text-blue:hover {
    color: var(--color-blue);
  }
  
  .text-blue {
    color: var(--color-blue);
  }
</style>
