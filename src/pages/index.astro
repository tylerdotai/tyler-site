---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Home"
  description="Tinkerer of AI, creative guy, collaborative community builder. Building in the open."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="max-w-3xl">
          <p class="section-label mb-4">Tinkerer of AI. Creative guy. Collaborative community builder.</p>
          <h1 class="text-5xl md:text-7xl font-serif mb-6 leading-tight">
            Tyler Delano
          </h1>
          <p class="text-xl text-[#888888] mb-8 leading-relaxed">
            IT Support Associate by day. AI agent builder by night. Running the Agent Builders Club
            — a DFW community of 600+ people learning to build with AI. Filmmaker on the side.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/builds" class="btn-primary">See what I build</a>
            <a href="/community" class="btn-ghost">Agent Builders Club</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Origin Story -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="section-label mb-4">How I got here</p>
            <h2 class="text-3xl font-serif mb-4">From PIP to tinkerer.</h2>
            <p class="text-[#888888] mb-4 leading-relaxed">
              March 2024, Amazon put me on a Performance Improvement Plan. Three months to turn it around
              or get cut. Instead of panic-applying to jobs, I got curious about AI agents.
            </p>
            <p class="text-[#888888] mb-4 leading-relaxed">
              Built a crew of AI subagents to handle the PIP tasks for me. They didn't save my job —
              but they did something better. They showed me what was actually possible when you stop
              using AI as a chatbot and start treating it like a workforce.
            </p>
            <p class="text-[#888888] leading-relaxed">
              Got rated "Exceeds High Bar" on my mid-year review. Got a raise. Decided: this is the
              thing. Let's go all in.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="card text-center">
              <span class="text-4xl font-serif" style="color:#C9A84C">600+</span>
              <p class="text-sm text-[#888888] mt-1">Community members</p>
            </div>
            <div class="card text-center">
              <span class="text-4xl font-serif" style="color:#C9A84C">6</span>
              <p class="text-sm text-[#888888] mt-1">DFW locations</p>
            </div>
            <div class="card text-center">
              <span class="text-4xl font-serif" style="color:#C9A84C">2024</span>
              <p class="text-sm text-[#888888] mt-1">Year the agents shipped</p>
            </div>
            <div class="card text-center">
              <span class="text-4xl font-serif" style="color:#C9A84C">1</span>
              <p class="text-sm text-[#888888] mt-1">ZV-E10 running</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What I'm building -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <p class="section-label mb-4">Recent builds</p>
        <h2 class="text-3xl font-serif mb-8">Tools, agents, and pipelines.</h2>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <a href="https://github.com/tylerdotai/singularity" target="_blank" rel="noopener noreferrer" class="nav-card group">
            <h3 class="font-serif text-xl mb-2 group-hover:text-[#C9A84C] transition-colors">Singularity</h3>
            <p class="text-sm text-[#888888] mb-3">Provider-neutral AI agent harness. Bun, TypeScript, SQLite. Runs on your own API keys.</p>
            <span class="text-xs font-mono text-[#888888]">github.com/tylerdotai/singularity</span>
          </a>

          <a href="https://github.com/tylerdotai/agent-loop-system" target="_blank" rel="noopener noreferrer" class="nav-card group">
            <h3 class="font-serif text-xl mb-2 group-hover:text-[#C9A84C] transition-colors">Agent Loop System</h3>
            <p class="text-sm text-[#888888] mb-3">Closed-loop agent harness with Python and JSON. Structured outputs, step-by-step reasoning.</p>
            <span class="text-xs font-mono text-[#888888]">github.com/tylerdotai/agent-loop-system</span>
          </a>

          <a href="https://github.com/tylerdotai/parkinson-research" target="_blank" rel="noopener noreferrer" class="nav-card group">
            <h3 class="font-serif text-xl mb-2 group-hover:text-[#C9A84C] transition-colors">AIAgainstParkinson</h3>
            <p class="text-sm text-[#888888] mb-3">Daily AI research pipeline for Parkinson's. PubMed → summary → EN/ES delivery. Every day, automatically.</p>
            <span class="text-xs font-mono text-[#888888]">github.com/tylerdotai/parkinson-research</span>
          </a>
        </div>

        <a href="/builds" class="btn-ghost">All builds →</a>
      </div>
    </section>

    <!-- Community -->
    <section class="section border-b border-[#2A2A2A]">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="section-label mb-4">DFW AI Community</p>
            <h2 class="text-3xl font-serif mb-4">Agent Builders Club</h2>
            <p class="text-[#888888] mb-4 leading-relaxed">
              Started as a side project. Now 600+ people across 6 physical locations in Dallas-Fort Worth
              learning how to build AI-powered workflows and agents. No fluff. Just builders showing
              each other what works.
            </p>
            <a href="/community" class="btn-primary">Learn more</a>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="card text-center">
              <span class="text-3xl font-serif" style="color:#C9A84C">600+</span>
              <p class="text-sm text-[#888888] mt-1">Members</p>
            </div>
            <div class="card text-center">
              <span class="text-3xl font-serif" style="color:#C9A84C">6</span>
              <p class="text-sm text-[#888888] mt-1">Physical nodes</p>
            </div>
            <div class="card text-center">
              <span class="text-3xl font-serif" style="color:#C9A84C">DFW</span>
              <p class="text-sm text-[#888888] mt-1">Metro area</p>
            </div>
            <div class="card text-center">
              <span class="text-3xl font-serif" style="color:#C9A84C">2024</span>
              <p class="text-sm text-[#888888] mt-1">Founded</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filming -->
    <section class="section">
      <div class="container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="section-label mb-4">Sony ZV-E10 Challenge</p>
            <h2 class="text-3xl font-serif mb-4">No crew. No script.</h2>
            <p class="text-[#888888] mb-4 leading-relaxed">
              39 days with the Sony ZV-E10. Every clip is a real moment. No production team.
              No plan. Just a camera and whatever showed up that day.
            </p>
            <p class="text-[#888888] mb-6 leading-relaxed">
              The documentary-style content is the brand amplifier. It's not a business.
              It's a habit. Follow along as it builds.
            </p>
            <a href="/creative" class="btn-ghost">See the footage →</a>
          </div>

          <div>
            <img
              src="/assets/creative/day2-sony.jpg"
              alt="Sony ZV-E10"
              loading="lazy"
              decoding="async"
              class="w-full h-64 object-cover rounded"
            />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
